@model IntemBB.Web.Models.IntemBBViewModel
@{
    ViewData["Title"] = "In lại tem hóa chất";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <style>
        .label-field { font-size: 16px; font-weight: bold; }
        .form-control-lg { font-size: 18px; font-weight: bold; }
        .main-table { background-color: #D0ECE7; border: 3px double #17202A; border-radius: 8px; padding: 20px; }
        .status-text { font-size: 16px; color: red; font-weight: bold; }
        .machine-radio label { font-size: 18px; margin-right: 20px; cursor: pointer; }
        .machine-radio input[type="radio"] { transform: scale(1.3); margin-right: 6px; }
    </style>
}

<div class="text-center mb-3">
    <h1 class="fw-bold" style="color: #1B2631; font-size: 40px;">In lại tem hóa chất</h1>
    <hr style="border: 1px solid #17202A;" />
</div>

@if (!string.IsNullOrEmpty(Model.ThongBao))
{
    <div class="alert alert-warning alert-dismissible fade show text-center fw-bold" role="alert">
        @Model.ThongBao
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-center">
    <div class="main-table" style="max-width: 1100px; width: 100%;">

        <div class="text-end mb-2">
            <span class="status-text">@Model.ConnectionStatus</span>
        </div>

        <form method="post" id="mainForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ThoiGianKT" />
            <input type="hidden" asp-for="PlanId" />

            <!-- Chọn máy -->
            <div class="row mb-3 align-items-center">
                <div class="col-md-2">
                    <label class="label-field">Chọn máy:</label>
                </div>
                <div class="col-md-10 machine-radio">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="SelectedMachine" value="rdMay1" id="rdMay1" onchange="this.form.action='@Url.Action("SelectMachine")'; this.form.submit();" />
                        <label class="form-check-label" for="rdMay1">Máy -1</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="SelectedMachine" value="rdMay2" id="rdMay2" onchange="this.form.action='@Url.Action("SelectMachine")'; this.form.submit();" />
                        <label class="form-check-label" for="rdMay2">Máy -9</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="SelectedMachine" value="rdMay02" id="rdMay02" onchange="this.form.action='@Url.Action("SelectMachine")'; this.form.submit();" />
                        <label class="form-check-label" for="rdMay02">Máy -1 mới</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="SelectedMachine" value="rdMay04" id="rdMay04" onchange="this.form.action='@Url.Action("SelectMachine")'; this.form.submit();" />
                        <label class="form-check-label" for="rdMay04">Máy -9 mới</label>
                    </div>
                </div>
            </div>

            <!-- Số Lô / Thời gian SX -->
            <div class="row mb-3">
                <div class="col-md-2">
                    <label class="label-field">Số Lô:</label>
                </div>
                <div class="col-md-4">
                    <input asp-for="SoLo" class="form-control form-control-lg" id="datepicker" autocomplete="off"
                           onchange="this.form.action='@Url.Action("SelectMachine")'; this.form.submit();" />
                </div>
                <div class="col-md-2">
                    <label class="label-field">Thời gian SX:</label>
                </div>
                <div class="col-md-4">
                    <input asp-for="ThoiGianSX" class="form-control form-control-lg" readonly />
                </div>
            </div>

            <!-- Chất / Ngày hiệu lực -->
            <div class="row mb-3">
                <div class="col-md-2">
                    <label class="label-field">@Model.LabelType:</label>
                </div>
                <div class="col-md-4">
                    <select asp-for="SelectedRecipe" asp-items="Model.RecipeList" class="form-select form-select-lg"
                            onchange="this.form.action='@Url.Action("SelectRecipe")'; this.form.submit();">
                        <option value="">-- Chọn --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="label-field">Ngày hiệu lực:</label>
                </div>
                <div class="col-md-4">
                    <input asp-for="NgayHieuLuc" class="form-control form-control-lg" readonly />
                </div>
            </div>

            <!-- Người thao tác / Số bọc hỏng -->
            <div class="row mb-3">
                <div class="col-md-2">
                    <label class="label-field">Người thao tác:</label>
                </div>
                <div class="col-md-4">
                    <input asp-for="NguoiThaoTac" class="form-control form-control-lg" readonly />
                </div>
                <div class="col-md-2">
                    <label class="label-field">Nhập số bọc hỏng:</label>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <input asp-for="SoMeSX" class="form-control form-control-lg" style="width: 120px;" />
                        <span class="fs-4 fw-bold">/</span>
                        <input asp-for="PlanNum" class="form-control form-control-lg" style="width: 120px;" readonly />
                    </div>
                </div>
            </div>

            <!-- Mở cho máy / Máy in -->
            <div class="row mb-3">
                <div class="col-md-2">
                    <label class="label-field">Mở cho máy:</label>
                </div>
                <div class="col-md-4">
                    <select asp-for="SelectedMayBB" asp-items="Model.MayBBList" class="form-select form-select-lg"></select>
                </div>
                <div class="col-md-2">
                    <label class="label-field">Máy in:</label>
                </div>
                <div class="col-md-4">
                    <select asp-for="SelectedMayIn" asp-items="Model.MayInList" class="form-select form-select-lg"></select>
                </div>
            </div>

            <!-- Mã mes / Nút In tem -->
            <div class="row mb-3 align-items-center">
                <div class="col-md-2">
                    <label class="label-field">Mã mes:</label>
                </div>
                <div class="col-md-4">
                    <input asp-for="PlanId" name="PlanIdDisplay" class="form-control form-control-lg" readonly />
                </div>
                <div class="col-md-6 text-center">
                    <button type="submit" asp-action="PrintLabel" class="btn btn-success btn-lg fw-bold px-5">
                        <i class="bi bi-printer"></i> In Tem
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        flatpickr("#datepicker", { dateFormat: "Y-m-d" });
    </script>
}
